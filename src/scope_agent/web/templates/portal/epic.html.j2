{% extends "portal/base.html.j2" %}
{% from "portal/_macros.html.j2" import sev %}
{% block title %}{{ page.subject }} · QA Impact Portal{% endblock %}
{% block content %}
{% set vq = ("&v=" ~ report.version) if pinned else "" %}
{% set vq1 = ("?v=" ~ report.version) if pinned else "" %}
<div class="crumb"><a href="/portal">Epics</a> › {{ page.subject }}</div>
<h2>{{ page.subject }}{% if page.title != page.subject %} · {{ page.title }}{% endif %}</h2>
<div class="strip">
  <div><b>{{ agg.counts.get("tickets", 0) }}</b> tickets</div><div><b>{{ agg.counts.get("developers", 0) }}</b> devs</div>
  <div><b>{{ agg.counts.get("repos", 0) }}</b> repos</div><div><b>{{ agg.counts.get("commits", 0) }}</b> commits</div>
  <div>{% if agg.severity_counts.get("high") %}{{ sev("high", agg.severity_counts["high"] ~ " high") }}{% endif %}
       {% if agg.severity_counts.get("medium") %}{{ sev("medium", agg.severity_counts["medium"] ~ " med") }}{% endif %}</div>
  <div class="new">Report v{{ report.version }}{% if report.version > 1 %} · +{{ diff.new_commits }} commits since v{{ report.version - 1 }}{% endif %}</div>
  {% if report.version != page.versions[-1].version %}<div class="muted">Older version. <a href="/portal/epics/{{ page.subject | urlencode }}?tab={{ tab }}">View latest</a></div>{% endif %}
</div>
{% if report.content.test_scope_status == "pending" %}
<div class="banner">Test scope pending (LLM budget). The impacted areas below are complete; the test scope will appear in the next report version.</div>
{% elif report.content.test_scope_status == "error" %}
<div class="banner">Test scope could not be generated for this version; it will be retried.</div>
{% endif %}
<nav class="tabs">
{% for t, label, group in [("areas-list", "Impacted areas", ("areas-list", "areas-matrix")), ("tickets", "Tickets", ("tickets",)), ("test-scope", "Test scope", ("test-scope",)), ("risks", "Risks", ("risks",)), ("history", "History", ("history",))] %}
  <a href="/portal/epics/{{ page.subject | urlencode }}?tab={{ t }}{{ vq }}" class="{{ 'on' if tab in group }}"
     hx-get="/portal/epics/{{ page.subject | urlencode }}/tab/{{ t }}{{ vq1 }}" hx-target="#tab-body" hx-push-url="/portal/epics/{{ page.subject | urlencode }}?tab={{ t }}{{ vq }}">{{ label }}</a>
{% endfor %}
</nav>
<div id="tab-body">{{ body | safe }}</div>
{% endblock %}
