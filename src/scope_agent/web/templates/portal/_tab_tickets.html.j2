{% set per_ticket = {} %}
{% for c in agg.matrix %}{% set _ = per_ticket.update({c.ticket: per_ticket.get(c.ticket, []) + [c.area]}) %}{% endfor %}
<div class="table-wrap">
<table>
<tr><th>Ticket</th><th>Summary</th><th>Status</th><th>Assignee</th><th>Areas</th></tr>
{% for t in agg.tickets %}
<tr>
  <td><a href="/portal/tickets/{{ t.key | urlencode }}">{{ t.key }}</a></td><td>{{ t.summary }}</td><td>{{ t.status }}</td><td>{{ t.assignee or "–" }}</td>
  <td>{% for a in per_ticket.get(t.key, []) %}<span class="tag">{{ a }}</span>{% else %}<span class="muted">none yet</span>{% endfor %}</td>
</tr>
{% else %}
<tr><td colspan="5" class="muted">No tickets known for this Epic.</td></tr>
{% endfor %}
</table>
</div>
