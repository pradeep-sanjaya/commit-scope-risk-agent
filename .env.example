# Source-control host: bitbucket (Data Center) or github (github.com / GitHub Enterprise Server)
SCOPE_SOURCE_PROVIDER=bitbucket
# Bitbucket Data Center base URL (required when SCOPE_SOURCE_PROVIDER=bitbucket)
SCOPE_BITBUCKET_URL=
# Bitbucket Bearer token (required when SCOPE_SOURCE_PROVIDER=bitbucket)
SCOPE_BITBUCKET_TOKEN=
# GitHub web base for commit links (GitHub Enterprise Server: https://<host>)
SCOPE_GITHUB_URL=https://github.com
# Shared secret for the webhook HMAC (Bitbucket X-Hub-Signature, GitHub X-Hub-Signature-256)
SCOPE_WEBHOOK_SECRET=
# JIRA Cloud base URL
SCOPE_JIRA_URL=
# JIRA service account email (basic auth)
SCOPE_JIRA_EMAIL=
# JIRA API token
SCOPE_JIRA_TOKEN=
# Comma-separated JIRA project keys to recognise in commit messages
SCOPE_JIRA_PROJECT_KEYS=
# Comma-separated branch patterns to analyze
SCOPE_BRANCHES=development,hotfix/*,release/*
# JIRA custom field id holding acceptance criteria (optional)
SCOPE_JIRA_AC_FIELD=
# Description heading used to find acceptance criteria when no field is set
SCOPE_JIRA_AC_HEADING=Acceptance Criteria
# Seconds to cache JIRA ticket lookups
SCOPE_JIRA_CACHE_TTL_SECONDS=600
# LLM provider (only "anthropic" is supported)
SCOPE_LLM_PROVIDER=anthropic
# LLM API key
SCOPE_LLM_API_KEY=
# LLM model name
SCOPE_LLM_MODEL=claude-sonnet-5-5
# LLM API base URL override (optional)
SCOPE_LLM_BASE_URL=
# Daily LLM token budget; jobs defer to the next day when exhausted
SCOPE_LLM_DAILY_TOKEN_BUDGET=2000000
# Maximum input tokens per LLM call
SCOPE_LLM_MAX_INPUT_TOKENS=60000
# Maximum output tokens per LLM call
SCOPE_LLM_MAX_OUTPUT_TOKENS=4096
# Comma-separated globs of files excluded from analysis
SCOPE_FILES_EXCLUDE=**/package-lock.json,**/*.min.js,**/generated/**,**/dist/**,**/target/**,**/node_modules/**
# Comma-separated globs of files analyzed first
SCOPE_FILES_PRIORITY=**/application*.yml,**/application*.yaml,**/application*.properties,**/*envoy*.y*ml,**/*gateway*.y*ml,**/helm/**,**/k8s/**,**/Dockerfile,**/environment*.ts,**/proxy.conf.json
# Maximum commits analyzed per push
SCOPE_MAX_COMMITS_PER_PUSH=200
# Maximum LLM chunks per commit
SCOPE_MAX_CHUNKS_PER_COMMIT=3
# GitHub REST API base: release notes, and the source host when SCOPE_SOURCE_PROVIDER=github (Enterprise: https://<host>/api/v3)
SCOPE_GITHUB_API_URL=https://api.github.com
# GitHub token (required when SCOPE_SOURCE_PROVIDER=github: read access to the repos; otherwise optional, raises release-note rate limits)
SCOPE_GITHUB_TOKEN=
# Nexus base URL
SCOPE_NEXUS_URL=
# Nexus user
SCOPE_NEXUS_USER=
# Nexus password
SCOPE_NEXUS_PASSWORD=
# Nexus Maven repository name
SCOPE_NEXUS_MAVEN_REPO=maven-public
# Nexus npm repository name
SCOPE_NEXUS_NPM_REPO=npm-group
# Maximum characters of library docs sent to the LLM
SCOPE_DOCS_MAX_CHARS=40000
# Maximum characters of usage context sent to the LLM
SCOPE_USAGE_CONTEXT_MAX_CHARS=20000
# Maximum characters of a library profile
SCOPE_LIBRARY_PROFILE_MAX_CHARS=30000
# SMTP host (docker-compose runs mailpit; its UI is on port 8025)
SCOPE_SMTP_HOST=mailpit
# SMTP port (mailpit listens on 1025)
SCOPE_SMTP_PORT=1025
# SMTP user (optional)
SCOPE_SMTP_USER=
# SMTP password (optional)
SCOPE_SMTP_PASSWORD=
# Use STARTTLS (true/false); mailpit does not offer it
SCOPE_SMTP_STARTTLS=false
# From address for emails
SCOPE_SMTP_FROM=
# Public base URL used in email links
SCOPE_PUBLIC_BASE_URL=
# Secret used to sign rating links
SCOPE_RATING_SECRET=
# Seconds to wait before generating an epic report after the last change
SCOPE_REPORT_DEBOUNCE_SECONDS=300
# Request header carrying the authenticated portal user (optional)
SCOPE_PORTAL_AUTH_HEADER=
# Database URL; the value below matches docker-compose
SCOPE_DATABASE_URL=postgresql+psycopg://scope:scope@postgres:5432/scope
# Comma-separated digest recipient emails
SCOPE_DIGEST_RECIPIENTS=
# Path to the routing YAML file (docker-compose mounts ./deploy at /config)
SCOPE_ROUTING_FILE=/config/routing.example.yaml
# Path to the dependency hints YAML file (docker-compose: /config/...)
SCOPE_DEPENDENCY_HINTS_FILE=/config/dependency-hints.example.yaml
# Path to the areas YAML file (docker-compose: /config/...)
SCOPE_AREAS_FILE=/config/areas.example.yaml
# Timezone for digests and scheduling
SCOPE_TIMEZONE=UTC
# Outbound HTTP timeout in seconds
SCOPE_HTTP_TIMEOUT_SECONDS=30.0
# Job lease duration in seconds
SCOPE_JOB_LEASE_SECONDS=900
# Comma-separated retry backoff delays in seconds
SCOPE_RETRY_BACKOFF_SECONDS=30,120,600
# Worker queue poll interval in seconds
SCOPE_WORKER_POLL_SECONDS=2.0
# Log level
SCOPE_LOG_LEVEL=INFO
# Web server port (no SCOPE_ prefix)
PORT=8080
